# Copy to .env and fill in what you need. Every value has a working default
# except the language-model credentials: without them the app still runs and
# returns verified passages, but says plainly that no AI guidance was generated.

# --- Language model -----------------------------------------------------------
# anthropic (default) | openai (any OpenAI-compatible endpoint) | none
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Optional faster model for the understanding step (defaults to LLM_MODEL).
# LLM_FAST_MODEL=claude-haiku-5-5
# LLM_UNDERSTAND_EFFORT=low
# LLM_ANSWER_EFFORT=medium
# Anthropic only: retry safety-classifier refusals on the recommended fallback model.
# LLM_REFUSAL_FALLBACKS=true

# OpenAI-compatible example (OpenAI, Groq, OpenRouter, vLLM, Ollama, ...):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_MODEL=gpt-5.5
# LLM_BASE_URL=https://api.openai.com/v1
# Local Ollama example:
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_JSON_MODE=json_schema   # or json_object if the server lacks schema support

# --- Retrieval ------------------------------------------------------------------
# postgres (default: `make db` starts it, with Docker running) | memory (no database;
# `make api-memory` runs the API this way without changing this file)
RETRIEVAL_BACKEND=postgres
DATABASE_URL=postgresql://wisdom:wisdom@localhost:54329/wisdom
# Local multilingual embeddings by default (no key needed, ~120 MB download once).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=

# --- API --------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]
ASK_RATE_LIMIT_PER_MINUTE=20
# Set true only when the API is reachable solely through the web app's proxy.
TRUST_FORWARDED_FOR=false
LOG_LEVEL=INFO

# --- Web (Next.js) -------------------------------------------------------------------
# Where the web server reaches the API (server-side only).
API_URL=http://127.0.0.1:8000
# The public address of the site, for absolute links in link previews (compiled in
# at build time). Without it, previews point at localhost.
# NEXT_PUBLIC_SITE_URL=https://bodh.example
# The product is BODH; its identity lives in web/src/lib/brand.ts. This replaces
# the name alone, for a deployment of its own (compiled in at build time).
# NEXT_PUBLIC_APP_NAME=BODH

# --- Ingestion ------------------------------------------------------------------------
# Wikimedia asks automated clients to identify themselves; include a contact URL.
# INGEST_USER_AGENT=bodh-ingest/0.1 (https://your-project-url)
