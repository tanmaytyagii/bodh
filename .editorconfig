# Editor settings for the repository (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,sql}]
indent_size = 4

[Makefile]
indent_style = tab

# Source texts exactly as they were downloaded: each must still match the
# checksum in its manifest.json (see .gitattributes), so editors leave them alone.
[backend/data/raw/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
